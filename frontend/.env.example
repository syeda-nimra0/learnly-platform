# Frontend environment variables
# These are PUBLIC (VITE_ prefix means they're embedded in the bundle).
# NEVER put secrets here. The Gemini API key, MongoDB URI, JWT secrets,
# and Cloudinary API Secret all live in backend/.env instead.

# Backend API URL
VITE_API_URL=http://localhost:5000/api

# Cloudinary cloud name - PUBLIC, used to build image URLs in the browser
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name

# Optional: unsigned upload preset for direct browser uploads (NOT recommended for production)
# VITE_CLOUDINARY_UPLOAD_PRESET=learnly_unsigned
