# =============================================================================
# ROOT .env.example - shows ALL variables used by the project
# Copy this file to frontend/.env AND backend/.env and fill in the relevant
# values for each. NEVER commit real .env files to git.
# =============================================================================

# -----------------------------------------------------------------------------
# BACKEND ONLY  (put these in backend/.env)
# -----------------------------------------------------------------------------

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas connection string
# Get from: Atlas Dashboard -> Database -> Connect -> Drivers -> Node.js
MONGODB_URI=mongodb+srv://learnly_user:CHANGE_ME@cluster0.abc123.mongodb.net/learnly?retryWrites=true&w=majority

# JWT secrets - generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=generate_a_64_char_random_hex_string_here
JWT_REFRESH_SECRET=generate_another_64_char_random_hex_string_here
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
COOKIE_SECURE=false

# === GEMINI API ===  (CRITICAL: NEVER put this in frontend/.env)
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaSy_REPLACE_WITH_YOUR_REAL_KEY
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TIMEOUT_MS=30000
GEMINI_MAX_INPUT_CHARS=8000

# === CLOUDINARY ===  (server-side credentials - secret!)
# Get from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_UPLOAD_FOLDER=learnly

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
AI_RATE_LIMIT_MAX=20


# -----------------------------------------------------------------------------
# FRONTEND ONLY  (put these in frontend/.env)
# -----------------------------------------------------------------------------

# Backend API URL (no secrets!)
VITE_API_URL=http://localhost:5000/api

# Cloudinary cloud name - this is PUBLIC (used to build image URLs)
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name

# Optional: only if using unsigned browser uploads (NOT recommended for prod)
# VITE_CLOUDINARY_UPLOAD_PRESET=learnly_unsigned
